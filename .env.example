# Copiar a .env.local (nunca comitear .env.local) y rellenar con los valores reales del proyecto Supabase.
# Variables EXPO_PUBLIC_* son visibles en el cliente (bundle de la app) — nunca poner ahí secretos de servidor.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Credenciales OAuth de Google, configuradas como proveedor en Supabase Auth (Authentication → Providers → Google).
# El Client Secret vive solo en el dashboard de Supabase, nunca en el cliente ni en este repo.
GOOGLE_OAUTH_CLIENT_ID=

# Solo para uso local (CLI de Supabase, migraciones, conexión directa a la BBDD) — NUNCA en el cliente/app.
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=
SUPABASE_DB_PASSWORD=

# Solo para src/scripts/historico/importHistorico.ts (f-008-historical-data-import),
# el script one-off de migración del histórico a Supabase. Sin prefijo
# EXPO_PUBLIC_ a propósito: la service role key bypassa RLS y tiene permisos
# totales sobre la base de datos. NUNCA usar prefijo EXPO_PUBLIC_ ni
# referenciar estas variables desde src/app/, src/components/ ni
# src/services/: expondría la clave con permisos totales en el bundle del
# cliente móvil (ver src/__tests__/scripts/historico/security.test.ts, R7.3).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
